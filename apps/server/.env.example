# ───────────────────────────────────────────────
# Server
# ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ───────────────────────────────────────────────
# Database (Supabase PostgreSQL connection string)
# For local dev with docker-compose (host port 5433 to avoid clashing
# with a native Postgres on 5432):
#   postgresql://postgres:postgres@localhost:5433/docsign
# ───────────────────────────────────────────────
DATABASE_URL=

# ───────────────────────────────────────────────
# JWT
# Use long random strings (min 32 chars each)
# ───────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ───────────────────────────────────────────────
# Supabase Storage
# ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=docsign

# ───────────────────────────────────────────────
# Upstash Redis (REST)
# ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────────────────────────────
# Resend (transactional email)
# ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ───────────────────────────────────────────────
# App
# ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3010
